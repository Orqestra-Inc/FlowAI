# ── App ────────────────────────────────────────────────────────────────
APP_NAME=Orqestra
# The business agent's name, as users address it ("Ask Flow").
AGENT_NAME=Flow
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
SESSION_SECRET=change-me-to-32-plus-random-bytes
DATABASE_PATH=./data/orqestra.db

# ── Model (any LangChain initChatModel "provider:model") ──────────────
# Examples: google-genai:gemini-3.8-flash | openai:gpt-4.1-mini | anthropic:claude-haiku-4-5
LLM_MODEL=google-genai:gemini-3.8-flash
# Models tried in order when the main one is rate-limited, out of daily quota or overloaded.
# Free-tier quotas are per model, so extra models add capacity on the same key.
# Unset + a Gemini main model = gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite. Set empty to disable.
# LLM_FALLBACK_MODELS=google-genai:gemini-3.6-flash,google-genai:gemini-3.5-flash-lite
# Retries (with backoff) for per-minute rate limits and overload, per model. 0 disables.
LLM_RETRIES=2
# Set the key for the provider you use (names follow each LangChain provider package):
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── ArmorIQ ────────────────────────────────────────────────────────────
ARMORIQ_API_KEY=ak_test_...
# Must EXACTLY match what is registered in the ArmorIQ platform console (platform.armoriq.ai) (a mismatch fails silently).
ARMORIQ_AGENT_NAME=orqestra-agent
ARMORIQ_MCP_NAME=orqestra-erp
# How long a HELD tool waits for approval in the ArmorIQ console. Timeout = refused.
APPROVAL_WAIT_SECONDS=90
# Where the app's "Open ArmorIQ approvals" link points. Best: the exact approvals page URL on platform.armoriq.ai.
# ARMORIQ_CONSOLE_URL=https://platform.armoriq.ai
# Callback handlers must run inline so ArmorIQ can stop a tool before it executes.
LANGCHAIN_CALLBACKS_BACKGROUND=false

# ── MCP discovery endpoint (/mcp) ─────────────────────────────────────
# Register PUBLIC_BASE_URL/mcp in ArmorIQ with this bearer token as its credential.
# /mcp lists tools only; direct tool execution through it is disabled.
MCP_BEARER_TOKEN=change-me-to-32-plus-random-bytes

# ── Voice: ElevenLabs (optional) ──────────────────────────────────
# Speak requests (Speech-to-Text) and hear Flow's replies (Text-to-Speech). Leave empty to hide voice.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
VOICE_LIMIT_PER_HOUR=60
VOICE_LIMIT_PER_DAY=600

# ── Limits ─────────────────────────────────────────────────────────────
MAX_TOOL_CALLS=12
MAX_MODEL_CALLS=10
MAX_PO_AMOUNT=300000

# ── Demo ──────────────────────────────────────────────────────────────
# Optional sign-in code for a public demo (share it only with judges/testers).
DEMO_ACCESS_CODE=
# Quota guard for the model key: chat requests per browser per hour, and per day overall.
CHAT_LIMIT_PER_HOUR=40
CHAT_LIMIT_PER_DAY=400
DEMO_MODE=1
# Lets the owner run a request WITHOUT ArmorIQ (red UNPROTECTED banner) for the before/after demo.
# Honoured only when DEMO_MODE=1. Never enable in a real deployment.
DEMO_ALLOW_UNPROTECTED=0

# Optional: identity ArmorIQ evaluates policy for, per app user (only if member rules must match org members)
# ARMORIQ_IDENTITY_MAP=owner@baraka.demo=you@example.com,procurement@baraka.demo=you@example.com,accountant@baraka.demo=you@example.com
# Optional hint shown under the access-code field (empty by default). Prefer a private ?code= invite link.
# DEMO_ACCESS_CODE_HINT=

# ── Demo video recorder (npm run demo:video), local only ──────────────
# DEMO_URL=https://orqestra.onrender.com
# DEMO_CODE=
# NARRATOR_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
